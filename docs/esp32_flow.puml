@startuml
title ESP32 Firmware Flow - sketch_oct3a_robot

start
:Init Serial, GPIOs, PWM channels;
:Init Encoder (ESP32Encoder.attachHalfQuad, setCount(0));
:Init Steppers (setMaxSpeed, setAcceleration, moveTo(0));
:setupWifiAP();
if (WiFi connected?) then (yes)
  :setupFirebase();
  :Firebase.beginStream(fbdo, "/tt_robot_xyz/control");
  :setup_webserver() (POST /command, GET /current_position);
else (no)
  :Start AP mode only;
endif
:Create RTOS tasks: MoveJog, Robot_task_AUTO, SetHome_task, ReturnToHome, Robot_task_Classify;

partition MainLoop {
  while (true)
    :loopWifiAP();
    :loopFirebase();
    :handleSerialInput();
    :Periodic debug prints;
  endwhile
}

partition FirebaseStream {
  :streamCallback(StreamData data);
  if (data.path == "/" and dataType==json) then (true)
    :extract jog/command_jog -> command_jog;
    :extract size/* -> Object_*_size;
    :extract funtion/Task -> task (may set Mode);
    :extract Autochain/TotalSteps -> TotalSteps;
    if (Autochain/Coordinates_auto present?) then (yes)
      :parseArray(result.to<String>());
    endif
    if (Classify/Coordinates_auto present?) then (yes)
      :parseArray(result.to<String>());
    endif
  else (other path)
    if (data.path == "/Autochain/Coordinates_auto" or "/control/Autochain/Coordinates_auto") then (yes)
      :parseArray(data.jsonString());
    else
      :handle leaf updates (jog, size, funtion, totals);
    endif
  endif
}

partition parseArray {
  :if jsonStr empty/null -> try Firebase.get(fbdo_push, "/tt_robot_xyz/control/Autochain/Coordinates_auto");
  if (fetched payload OK?) then (yes)
    :payload = fbdo_push.jsonString();
  else (no)
    :abort parse (leave old data);
  endif
  :deserialize JSON (DynamicJsonDocument ~16KB);
  if (doc is Array) then (array)
    :for each element -> fill Coordinates_auto[i];
  else if (doc is Object) then (map)
    :for each kv -> fill Coordinates_auto[i];
  endif
  :TotalSteps = parsedCount;
  :log first points for debug;
}

partition RTOS_Tasks {
  fork
    :MoveJog (Mode==0) -> set speeds, moveTo large targets, Axis.run(), MoveAxisGripper();
  fork again
    :Robot_task_AUTO (Mode==1) -> if axes stopped and gripper target reached -> autoChainStep++;
    :set speeds/moveTo from Coordinates_auto[autoChainStep];
  fork again
    :Robot_task_Classify (Mode==2) -> similar to AUTO but uses Classify[] and classification branching;
  fork again
    :SetHome_task (Mode==-2 recommended) -> state-machine: Base -> Shoulder -> Elbow -> Gripper (stall detect) -> Mode=-3;
  fork again
    :ReturnToHome (Mode==-1) -> moveTo(0) until complete -> Mode=-3;
  end fork
}

note right of RTOS_Tasks: Tasks run concurrently; they check Mode each loop and perform non-blocking Axis.run()/runSpeed() calls.

stop
@enduml
